// Proyecto compartido cuadrapp-899d5.
// Esta es la copia que se despliega. cuadrapp/firestore.rules tiene que ser idéntica:
// desplegar la versión corta deja las colecciones de NODUS en denegación.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sesion() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    /** Sin esto, una cuenta de correo/contraseña sin verificar con uno de estos emails sería admin. */
    function verificado() {
      return request.auth.token.email_verified == true;
    }

    function esSuperAdmin() {
      return sesion() && verificado() && email() == 'buba12@gmail.com';
    }

    function esAdminJefes() {
      return sesion() && verificado() && email() in ['jonymivi@gmail.com', 'jony.mivi@gmail.com'];
    }

    function perfilConsulta() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    /** El perfil entra como argumento para leerlo una vez: cada get() cuenta contra el límite de 1000 expresiones. */
    function perfilConRol(perfil, roles) {
      return perfil.activo == true
        && perfil.rolAcceso in roles
        && perfil.email is string
        && perfil.email.lower() == email();
    }

    function tienePerfilConRol(roles) {
      return sesion()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilConRol(perfilConsulta(), roles);
    }

    function esConsulta() {
      return tienePerfilConRol(['CONSULTA_JEFES']);
    }

    function esAdminNominado() {
      return tienePerfilConRol(['ADMIN', 'SUPERADMIN']);
    }

    function leeTodo() {
      return esSuperAdmin() || esAdminJefes() || esAdminNominado();
    }

    function leeJefes() {
      return leeTodo() || esConsulta();
    }

    function esJefaturaConsulta() {
      return esConsulta()
        && perfilConsulta().agenteId is string
        && perfilConsulta().agenteId.size() > 0
        && exists(/databases/$(database)/documents/agentes/$(perfilConsulta().agenteId))
        && get(/databases/$(database)/documents/agentes/$(perfilConsulta().agenteId)).data.rolBase
          in ['JEFE_SERVICIO', 'RESPONSABLE'];
    }

    /*
     * Firmas. Admin firma libre; un agente de consulta firma con la placa y el
     * nombre de su documento usuarios/{uid}. Quien llama ya ha comprobado
     * esUsuarioNodus().
     * Firestore corta en 1000 expresiones por escritura y el registro diario
     * va al límite: la firma de consulta va antes que leeTodo() para no
     * repetirlo. Sin documento usuarios (cuentas fijas) la firma da error, y
     * error || true sigue siendo true.
     */
    function placaDeConsulta(placa) {
      let suya = perfilConsulta().get('numeroPlaca', '');
      return suya is string && suya.trim().size() > 0 && placa == suya.trim();
    }

    function nombreDeConsulta(nombre) {
      let suyo = perfilConsulta().get('nombre', '');
      return suyo is string && nombre == suyo.trim();
    }

    function nombrePropio(nombre) {
      return nombreDeConsulta(nombre) || leeTodo();
    }

    function firmaPropia(nombre, placa) {
      return (placaDeConsulta(placa) && nombreDeConsulta(nombre)) || leeTodo();
    }

    match /usuarios/{uid} {
      allow get: if sesion() && request.auth.uid == uid;
      allow list: if esSuperAdmin() || esAdminJefes();
      allow create, delete: if esSuperAdmin();
      allow update: if esSuperAdmin()
        || (esAdminJefes()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puedeEditarEventos']));
    }

    match /agentes/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin() || esAdminJefes();
    }

    match /puestos/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin();
    }

    match /tiposPermiso/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin() || esAdminJefes();
    }

    match /tiposEvento/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin() || esAdminJefes();
    }

    match /cuadrantesJefes/{id} {
      allow read: if leeTodo() || esJefaturaConsulta();
      allow write: if esSuperAdmin() || esAdminJefes();
    }

    function editaEventos() {
      return esSuperAdmin()
        || esAdminJefes()
        || (esConsulta() && perfilConsulta().puedeEditarEventos == true);
    }

    /** Forma que escribe Cuadrapp (saveEvento, con merge). */
    function eventoValido(docId) {
      return request.resource.data.id == docId
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.tipo is string
        && request.resource.data.tipo.matches('^[A-Z][A-Z0-9_]{0,39}$')
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() <= 2000
        && request.resource.data.modificadoresMinimos is map
        && request.resource.data.modificadoresMinimos.size() <= 80;
    }

    match /eventos/{id} {
      allow read: if leeJefes();
      allow create: if editaEventos()
        && eventoValido(id)
        && request.resource.data.keys().hasOnly(['id', 'fecha', 'tipo', 'descripcion', 'modificadoresMinimos']);
      allow update: if editaEventos()
        && eventoValido(id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['id', 'fecha', 'tipo', 'descripcion', 'modificadoresMinimos']);
      allow delete: if editaEventos();
    }

    match /config/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin();
    }

    function idMesCuadrante(anio, mes) {
      return string(anio) + '-' + (mes < 10 ? '0' + string(mes) : string(mes));
    }

    function cuadranteOperativoForma(docId) {
      return request.resource.data.keys().hasAll(['anio', 'mes', 'agentes', 'actualizadoEn'])
        && request.resource.data.anio is int
        && request.resource.data.anio >= 2020
        && request.resource.data.anio <= 2040
        && request.resource.data.mes is int
        && request.resource.data.mes >= 1
        && request.resource.data.mes <= 12
        && docId == idMesCuadrante(request.resource.data.anio, request.resource.data.mes)
        && request.resource.data.agentes is map
        && request.resource.data.agentes.size() <= 400
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    function cuadranteEsMesActual() {
      return request.resource.data.anio == request.time.year()
        && request.resource.data.mes == request.time.month();
    }

    /** Jefatura solo escribe el cuadrante operativo del mes en curso, y solo sus campos. */
    function cuadranteJefaturaCreate(docId) {
      return esJefaturaConsulta()
        && cuadranteEsMesActual()
        && cuadranteOperativoForma(docId)
        && request.resource.data.keys().hasOnly(['anio', 'mes', 'agentes', 'actualizadoEn']);
    }

    function cuadranteJefaturaUpdate(docId) {
      return esJefaturaConsulta()
        && cuadranteEsMesActual()
        && cuadranteOperativoForma(docId)
        && request.resource.data.anio == resource.data.anio
        && request.resource.data.mes == resource.data.mes
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['agentes', 'actualizadoEn']);
    }

    match /cuadrantes/{id} {
      allow read: if leeJefes();
      allow create: if leeTodo() || cuadranteJefaturaCreate(id);
      allow update: if leeTodo() || cuadranteJefaturaUpdate(id);
      allow delete: if leeTodo();
    }

    match /planesAnuales/{id} {
      allow read: if leeJefes();
      allow write: if esSuperAdmin();
    }

    match /roadmap/{id} {
      allow read, write: if leeTodo();
    }

    /** Usuarios con acceso a NODUS (admin o consulta de Cuadrapp). */
    function esUsuarioNodus() {
      return leeJefes();
    }

    function notaRelevoValida() {
      return request.resource.data.keys().hasOnly([
          'tipo', 'puestoId', 'puestoNombre', 'fechaInicio', 'fechaFin', 'turnos',
          'texto', 'autorUid', 'autorNombre', 'autorEmail', 'autorPlaca',
          'creadoEn', 'actualizadoEn', 'activo',
          'imagenData', 'imagenNombre',
          'fechaAsignacion', 'puestoCodigo', 'turnoCuadrante',
          'estadoValidacion'
        ])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.autorEmail is string
        && request.resource.data.autorEmail.size() <= 200
        && (
          !request.resource.data.keys().hasAny(['autorPlaca'])
          || request.resource.data.autorPlaca == null
          || (
            request.resource.data.autorPlaca is string
            && request.resource.data.autorPlaca.size() <= 32
          )
        )
        && request.resource.data.puestoId is string
        && request.resource.data.puestoId.size() > 0
        && request.resource.data.puestoId.size() <= 80
        && request.resource.data.puestoNombre is string
        && request.resource.data.puestoNombre.size() <= 120
        && request.resource.data.fechaInicio is string
        && request.resource.data.fechaInicio.size() == 10
        && request.resource.data.fechaFin is string
        && request.resource.data.fechaFin.size() == 10
        && request.resource.data.fechaFin >= request.resource.data.fechaInicio
        && request.resource.data.turnos is list
        && request.resource.data.turnos.size() <= 3
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 4000
        && request.resource.data.activo == true
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40
        && (
          !request.resource.data.keys().hasAny(['imagenData'])
          || (
            request.resource.data.imagenData is string
            && request.resource.data.imagenData.size() > 0
            && request.resource.data.imagenData.size() <= 450000
          )
        );
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function nombreEsCecop(nombre) {
      return nombre.matches('(?i)^centro de control 1$')
        || nombre.matches('(?i)^centro de control 2$')
        || nombre.matches('(?i)^control de accesos$');
    }

    /**
     * El agente tiene, en el cuadrante de MoAPP de esa fecha, un puesto del CPCS
     * (Centro de Control 1, Centro de Control 2 o Control de Accesos).
     */
    function asignadoEnCecop() {
      let fecha = request.resource.data.fechaAsignacion;
      let anio = int(fecha[0:4]);
      let mes = int(fecha[5:7]);
      let dia = int(fecha[8:10]);
      let idMes = string(anio) + '-' + pad2(mes);
      let cuadrante = get(/databases/$(database)/documents/cuadrantes/$(idMes)).data;
      let placa = perfilConsulta().numeroPlaca;
      let celda = cuadrante.agentes[placa][dia - 1];
      let codigo = request.resource.data.puestoCodigo;
      let puesto = get(/databases/$(database)/documents/puestos/$(codigo)).data;
      let turno = request.resource.data.turnoCuadrante;
      return fecha is string
        && fecha.size() == 10
        && codigo is string
        && celda.keys().hasAll(['t', 'p'])
        && puesto.abreviatura == celda.p
        && nombreEsCecop(puesto.nombre)
        && (
          (turno == 'M' && (celda.t == 'M' || celda.t == 'MT'))
          || (turno == 'T' && (celda.t == 'T' || celda.t == 'MT'))
          || (turno == 'N' && celda.t == 'N')
        );
    }

    function marcaTiempoCorta(valor) {
      return valor is string && valor.size() >= 20 && valor.size() <= 40;
    }

    /** Pasa un relevo apuntado a visible para el turno siguiente, sin tocar el texto. */
    function publicarBorradorRelevo() {
      return esUsuarioNodus()
        && resource.data.tipo == 'RELEVO'
        && resource.data.activo == true
        && resource.data.estadoValidacion == 'PENDIENTE'
        && request.resource.data.estadoValidacion == 'PUBLICADA'
        && marcaTiempoCorta(request.resource.data.actualizadoEn)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estadoValidacion', 'actualizadoEn']);
    }

    /** El autor o un admin solo pueden archivar la nota. El texto y el tipo no cambian. */
    function desactivarNotaRelevo() {
      return esUsuarioNodus()
        && (resource.data.autorUid == request.auth.uid || leeTodo())
        && resource.data.activo == true
        && request.resource.data.activo == false
        && marcaTiempoCorta(request.resource.data.actualizadoEn)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activo', 'actualizadoEn']);
    }

    /** Publicar o rechazar un aviso pendiente, sin tocar el contenido. */
    function validarAvisoRelevo() {
      return (leeTodo() || esJefaturaConsulta())
        && resource.data.tipo == 'AVISO'
        && resource.data.estadoValidacion == 'PENDIENTE'
        && request.resource.data.estadoValidacion in ['PUBLICADA', 'RECHAZADA']
        && request.resource.data.validadoPorUid == request.auth.uid
        && request.resource.data.validadoPorNombre is string
        && request.resource.data.validadoPorNombre.size() > 0
        && request.resource.data.validadoPorNombre.size() <= 120
        && nombrePropio(request.resource.data.validadoPorNombre)
        && marcaTiempoCorta(request.resource.data.validadoEn)
        && marcaTiempoCorta(request.resource.data.actualizadoEn)
        && request.resource.data.motivoRechazo is string
        && request.resource.data.motivoRechazo.size() <= 400
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estadoValidacion',
          'validadoPorUid',
          'validadoPorNombre',
          'validadoEn',
          'actualizadoEn',
          'motivoRechazo'
        ]);
    }

    /** Archivar una consigna. No permite reescribir texto, puesto ni turnos. */
    function desactivarNotaFija() {
      return (leeTodo() || esJefaturaConsulta())
        && resource.data.activo == true
        && request.resource.data.activo == false
        && marcaTiempoCorta(request.resource.data.actualizadoEn)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['activo', 'actualizadoEn']);
    }

    /**
     * Libro digital de relevos (NODUS Hub).
     * RELEVO = entrega al turno siguiente.
     * DIA con puesto CPCS = aviso del centro de control de ese día.
     * AVISO = nota a otro puesto o turno; entra al libro cuando jefatura la valida.
     */
    match /relevosNotas/{id} {
      allow read: if esUsuarioNodus();

      allow create: if esUsuarioNodus()
        && notaRelevoValida()
        && firmaPropia(request.resource.data.autorNombre, request.resource.data.autorPlaca)
        && (
          (
            request.resource.data.tipo == 'RELEVO'
            && request.resource.data.puestoId != 'CECOP'
            && (
              !request.resource.data.keys().hasAny(['estadoValidacion'])
              || request.resource.data.estadoValidacion == 'PENDIENTE'
            )
          )
          || (
            request.resource.data.tipo == 'DIA'
            && request.resource.data.puestoId == 'CECOP'
            && (leeTodo() || (esConsulta() && asignadoEnCecop()))
          )
          || (
            request.resource.data.tipo == 'AVISO'
            && request.resource.data.puestoId != 'CECOP'
            && request.resource.data.estadoValidacion == 'PENDIENTE'
            && request.resource.data.turnos.size() > 0
          )
        );

      allow update: if desactivarNotaRelevo() || validarAvisoRelevo() || publicarBorradorRelevo();

      /** El autor archiva (activo = false); borrar del libro queda para admin. */
      allow delete: if leeTodo();
    }

    /** Notas fijas por puesto: jefatura, admin y superadmin. */
    match /relevosNotasFijas/{id} {
      allow read: if esUsuarioNodus();
      allow create: if (leeTodo() || esJefaturaConsulta())
        && request.resource.data.keys().hasOnly([
          'puestoId', 'puestoNombre', 'turnos', 'texto',
          'autorUid', 'autorNombre', 'autorEmail', 'autorPlaca',
          'creadoEn', 'actualizadoEn', 'activo'
        ])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.puestoId is string
        && request.resource.data.puestoId.size() > 0
        && request.resource.data.puestoId.size() <= 80
        && request.resource.data.puestoNombre is string
        && request.resource.data.puestoNombre.size() > 0
        && request.resource.data.puestoNombre.size() <= 120
        && request.resource.data.turnos is list
        && request.resource.data.turnos.size() <= 3
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 4000
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.autorEmail is string
        && request.resource.data.autorEmail.size() <= 200
        && (
          request.resource.data.autorPlaca == null
          || (
            request.resource.data.autorPlaca is string
            && request.resource.data.autorPlaca.size() <= 32
          )
        )
        && marcaTiempoCorta(request.resource.data.creadoEn)
        && marcaTiempoCorta(request.resource.data.actualizadoEn)
        && request.resource.data.activo == true
        && firmaPropia(request.resource.data.autorNombre, request.resource.data.autorPlaca);
      allow update: if desactivarNotaFija();
      allow delete: if leeTodo() || esJefaturaConsulta();
    }

    function enteradoValido() {
      return request.resource.data.keys().hasOnly([
          'notaId', 'tipo', 'puestoId', 'puestoNombre',
          'fecha', 'turno', 'claveTurno',
          'uid', 'nombre', 'placa', 'identidad',
          'puestoLectorId', 'puestoLectorNombre',
          'leidoEn'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.notaId is string
        && request.resource.data.notaId.size() > 0
        && request.resource.data.notaId.size() <= 200
        && request.resource.data.tipo in ['FIJA', 'CECOP', 'RELEVO', 'AVISO']
        && request.resource.data.puestoId is string
        && request.resource.data.puestoId.size() > 0
        && request.resource.data.puestoId.size() <= 80
        && request.resource.data.puestoNombre is string
        && request.resource.data.puestoNombre.size() > 0
        && request.resource.data.puestoNombre.size() <= 120
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.turno in ['Mañana', 'Tarde', 'Noche']
        && request.resource.data.claveTurno == request.resource.data.fecha + '|' + (
          request.resource.data.turno == 'Mañana'
            ? 'M'
            : (request.resource.data.turno == 'Tarde' ? 'T' : 'N')
        )
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.placa is string
        && request.resource.data.placa.size() <= 32
        && request.resource.data.identidad is string
        && request.resource.data.identidad.size() > 0
        && request.resource.data.identidad.size() <= 128
        && (
          (request.resource.data.placa.size() > 0 && request.resource.data.identidad == request.resource.data.placa)
          || (request.resource.data.placa.size() == 0 && request.resource.data.identidad == request.auth.uid)
        )
        && request.resource.data.puestoLectorId is string
        && request.resource.data.puestoLectorId.size() <= 80
        && request.resource.data.puestoLectorNombre is string
        && request.resource.data.puestoLectorNombre.size() <= 120
        && request.resource.data.leidoEn is string
        && request.resource.data.leidoEn.size() >= 20
        && request.resource.data.leidoEn.size() <= 40
        && (enteradoDeConsulta() || leeTodo());
    }

    /** El cliente pone 'Agente' cuando el perfil no tiene nombre. */
    function enteradoDeConsulta() {
      let perfil = perfilConsulta();
      let suPlaca = perfil.get('numeroPlaca', '');
      let suNombre = perfil.get('nombre', '');
      return suPlaca is string
        && suNombre is string
        && request.resource.data.placa == suPlaca.trim()
        && request.resource.data.nombre == (suNombre.trim() == '' ? 'Agente' : suNombre.trim());
    }

    /** Enterado de una nota de servicio, por agente y turno. */
    match /relevosEnterados/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus() && enteradoValido();
      allow update: if esUsuarioNodus()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.notaId == resource.data.notaId
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.identidad == resource.data.identidad
        && enteradoValido();
      allow delete: if esUsuarioNodus() && resource.data.uid == request.auth.uid;
    }

    /**
     * Aceptar o rechazar desde la bandeja. El admin no reescribe el pedido:
     * solo pasa de PENDIENTE a ACEPTADA o RECHAZADA, con los campos que escribe el cliente.
     */
    function resolucionSolicitudBandeja() {
      return esAdminJefes()
        && resource.data.estado == 'PENDIENTE'
        && request.resource.data.resueltaEn is string
        && request.resource.data.resueltaEn.size() >= 20
        && request.resource.data.resueltaEn.size() <= 40
        && (
          (
            request.resource.data.estado == 'ACEPTADA'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['estado', 'resueltaEn', 'cobertura', 'coberturaNombre'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cobertura'])
              || (
                request.resource.data.cobertura is string
                && request.resource.data.cobertura.size() > 0
                && request.resource.data.cobertura.size() <= 80
              )
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coberturaNombre'])
              || (
                request.resource.data.coberturaNombre is string
                && request.resource.data.coberturaNombre.size() > 0
                && request.resource.data.coberturaNombre.size() <= 160
              )
            )
          )
          || (
            request.resource.data.estado == 'RECHAZADA'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['estado', 'resueltaEn', 'motivoRechazo'])
            && request.resource.data.motivoRechazo is string
            && request.resource.data.motivoRechazo.size() > 0
            && request.resource.data.motivoRechazo.size() <= 400
          )
        );
    }

    function esCompaneroPendiente() {
      return esConsulta()
        && resource.data.tipo in ['CAMBIO_DIA', 'CAMBIO_MES', 'VACACIONES']
        && resource.data.estado == 'PENDIENTE'
        && resource.data.validacionCompanero == 'PENDIENTE'
        && resource.data.companeroId == perfilConsulta().agenteId;
    }

    match /solicitudes/{id} {
      allow read: if esSuperAdmin()
        || esAdminJefes()
        || (esConsulta() && (
          resource.data.agenteId == perfilConsulta().agenteId
          || resource.data.companeroId == perfilConsulta().agenteId
        ));
      allow create: if esConsulta()
        && request.resource.data.keys().hasOnly([
          'id', 'tipo', 'estado', 'agenteId', 'placa', 'nombreAgente', 'fecha', 'creadaEn',
          'fechaFin', 'mesDestino', 'detalle', 'permisoCodigo', 'permisoNombre', 'resueltaEn',
          'cobertura', 'coberturaNombre', 'companeroId', 'companeroNombre', 'turno', 'turnoDestino',
          'motivoRechazo', 'validacionCompanero'
        ])
        && request.resource.data.id == id
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.creadaEn is string
        && request.resource.data.creadaEn.size() <= 40
        && request.resource.data.get('detalle', '') is string
        && request.resource.data.get('detalle', '').size() <= 2000
        && request.resource.data.agenteId == perfilConsulta().agenteId
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.tipo in ['PERMISO', 'CAMBIO_DIA', 'CAMBIO_MES', 'VACACIONES']
        && (
          request.resource.data.tipo == 'PERMISO'
          || (request.resource.data.tipo == 'VACACIONES'
            && request.resource.data.fecha is string
            && !(request.resource.data.fecha[5:7] in ['06', '07', '08', '09']))
          || request.resource.data.validacionCompanero == 'PENDIENTE'
        );
      allow update: if esSuperAdmin()
        || resolucionSolicitudBandeja()
        || (esCompaneroPendiente()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacionCompanero'])
          && request.resource.data.validacionCompanero == 'VALIDADA')
        || (esCompaneroPendiente()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacionCompanero', 'estado', 'resueltaEn', 'motivoRechazo'])
          && request.resource.data.validacionCompanero == 'RECHAZADA'
          && request.resource.data.estado == 'RECHAZADA'
          && request.resource.data.motivoRechazo is string
          && request.resource.data.motivoRechazo.size() > 0
          && request.resource.data.motivoRechazo.size() <= 400);
      allow delete: if false;
    }

    function movimientoGraficoValido() {
      return request.resource.data.keys().hasOnly([
          'fecha', 'hora', 'tipo', 'buque',
          'muelleId', 'muelleNombre', 'atraque', 'consignatario',
          'numeroEscala', 'numeroAgente', 'autorUid', 'creadoEn'
        ])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.hora is string
        && request.resource.data.hora.size() == 5
        && request.resource.data.tipo in ['ALTA', 'BAJA']
        && request.resource.data.buque is string
        && request.resource.data.buque.size() > 0
        && request.resource.data.buque.size() <= 120
        && request.resource.data.muelleId is string
        && request.resource.data.muelleId.size() > 0
        && request.resource.data.muelleId.size() <= 40
        && request.resource.data.muelleNombre is string
        && request.resource.data.muelleNombre.size() > 0
        && request.resource.data.muelleNombre.size() <= 80
        && request.resource.data.atraque is string
        && request.resource.data.atraque.size() > 0
        && request.resource.data.atraque.size() <= 16
        && request.resource.data.consignatario is string
        && request.resource.data.consignatario.size() > 0
        && request.resource.data.consignatario.size() <= 120
        && request.resource.data.numeroEscala is string
        && request.resource.data.numeroEscala.size() > 0
        && request.resource.data.numeroEscala.size() <= 40
        && request.resource.data.numeroAgente is string
        && request.resource.data.numeroAgente.size() > 0
        && request.resource.data.numeroAgente.size() <= 16
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && (
          leeTodo()
          || (esConsulta() && request.resource.data.numeroAgente == perfilConsulta().numeroPlaca)
        );
    }

    /** Libro de altas y bajas de NODUS Gráficos. Cada fila queda trazada con la placa. */
    match /graficosMovimientos/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus() && movimientoGraficoValido();
      allow update, delete: if false;
    }

    /**
     * Posiciones de atraque. No se comprueba cada punto: Firestore evalúa
     * como máximo 1000 expresiones y un bucle desenrollado por índice
     * deniega el guardado en cuanto hay unas cuarenta posiciones válidas.
     * Quien escribe este documento ya es admin (leeTodo).
     */
    function posicionesListaValida(lista) {
      return lista is list
        && lista.size() > 0
        && lista.size() <= 120;
    }

    function zonaGruaValida(item) {
      return item is map
        && item.keys().hasOnly(['muelleId', 'todos', 'atraques'])
        && item.muelleId is string
        && item.muelleId.size() > 0
        && item.muelleId.size() <= 40
        && item.todos is bool
        && item.atraques is list
        && item.atraques.size() <= 40
        && (item.todos == true || item.atraques.size() > 0);
    }

    function gruaValida() {
      return request.resource.data.keys().hasOnly(['nombre', 'zonas', 'activo', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.activo == true
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40
        && request.resource.data.zonas is list
        && request.resource.data.zonas.size() > 0
        && request.resource.data.zonas.size() <= 12
        && zonaGruaValida(request.resource.data.zonas[0])
        && (request.resource.data.zonas.size() < 2 || zonaGruaValida(request.resource.data.zonas[1]))
        && (request.resource.data.zonas.size() < 3 || zonaGruaValida(request.resource.data.zonas[2]))
        && (request.resource.data.zonas.size() < 4 || zonaGruaValida(request.resource.data.zonas[3]))
        && (request.resource.data.zonas.size() < 5 || zonaGruaValida(request.resource.data.zonas[4]))
        && (request.resource.data.zonas.size() < 6 || zonaGruaValida(request.resource.data.zonas[5]))
        && (request.resource.data.zonas.size() < 7 || zonaGruaValida(request.resource.data.zonas[6]))
        && (request.resource.data.zonas.size() < 8 || zonaGruaValida(request.resource.data.zonas[7]))
        && (request.resource.data.zonas.size() < 9 || zonaGruaValida(request.resource.data.zonas[8]))
        && (request.resource.data.zonas.size() < 10 || zonaGruaValida(request.resource.data.zonas[9]))
        && (request.resource.data.zonas.size() < 11 || zonaGruaValida(request.resource.data.zonas[10]))
        && (request.resource.data.zonas.size() < 12 || zonaGruaValida(request.resource.data.zonas[11]));
    }

    function zonaLlavesValida() {
      return request.resource.data.keys().hasOnly(['nombre', 'codigo', 'color', 'orden', 'creadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() <= 16
        && request.resource.data.color in ['rojo', 'azul', 'verde', 'ambar', 'violeta', 'teal']
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0
        && request.resource.data.orden <= 9999
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40;
    }

    function llavePuntoValido() {
      return !request.resource.data.keys().hasAny(['lat', 'lng', 'rumbo', 'escala'])
        || (
          request.resource.data.keys().hasAll(['lat', 'lng', 'rumbo', 'escala'])
          && request.resource.data.lat is number
          && request.resource.data.lat >= 42.1
          && request.resource.data.lat <= 42.35
          && request.resource.data.lng is number
          && request.resource.data.lng >= -9
          && request.resource.data.lng <= -8.55
          && request.resource.data.rumbo is number
          && request.resource.data.rumbo >= 0
          && request.resource.data.rumbo < 360
          && request.resource.data.escala is number
          && request.resource.data.escala >= 0.6
          && request.resource.data.escala <= 2.4
        );
    }

    function llaveCatalogoValida() {
      return request.resource.data.keys().hasOnly(['zonaId', 'numero', 'nombre', 'orden', 'creadoEn', 'lat', 'lng', 'rumbo', 'escala'])
        && request.resource.data.zonaId is string
        && request.resource.data.zonaId.size() > 0
        && request.resource.data.zonaId.size() <= 80
        && request.resource.data.numero is string
        && request.resource.data.numero.size() > 0
        && request.resource.data.numero.size() <= 16
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.orden is int
        && request.resource.data.orden >= 0
        && request.resource.data.orden <= 9999
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && llavePuntoValido();
    }

    /** Catálogo de zonas y llaves. Lo lee el centro de control; solo admin lo escribe. */
    match /llavesZonas/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if leeTodo() && zonaLlavesValida();
      allow delete: if leeTodo();
    }

    match /llaves/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if leeTodo() && llaveCatalogoValida();
      allow delete: if leeTodo();
    }

    /** Grúas del trabajo de buques. Las lee el centro de control; solo admin las escribe. */
    match /gruas/{id} {
      allow read: if esUsuarioNodus();
      allow create: if leeTodo() && gruaValida() && request.resource.data.keys().hasAll(['creadoEn']);
      allow update: if leeTodo() && gruaValida();
      allow delete: if leeTodo();
    }

    function parCalibracionValido(item) {
      return item is map
        && item.keys().hasOnly(['id', 'x', 'y', 'lat', 'lng', 'etiqueta'])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 40
        && item.etiqueta is string
        && item.etiqueta.size() <= 80
        && item.x is number
        && item.x >= 0
        && item.x <= 100
        && item.y is number
        && item.y >= 0
        && item.y <= 100
        && item.lat is number
        && item.lat >= 41.8
        && item.lat <= 43.3
        && item.lng is number
        && item.lng >= -9.5
        && item.lng <= -8.2;
    }

    function listaParesValida(lista) {
      return lista is list
        && lista.size() <= 12
        && (lista.size() < 1 || parCalibracionValido(lista[0]))
        && (lista.size() < 2 || parCalibracionValido(lista[1]))
        && (lista.size() < 3 || parCalibracionValido(lista[2]))
        && (lista.size() < 4 || parCalibracionValido(lista[3]))
        && (lista.size() < 5 || parCalibracionValido(lista[4]))
        && (lista.size() < 6 || parCalibracionValido(lista[5]))
        && (lista.size() < 7 || parCalibracionValido(lista[6]))
        && (lista.size() < 8 || parCalibracionValido(lista[7]))
        && (lista.size() < 9 || parCalibracionValido(lista[8]))
        && (lista.size() < 10 || parCalibracionValido(lista[9]))
        && (lista.size() < 11 || parCalibracionValido(lista[10]))
        && (lista.size() < 12 || parCalibracionValido(lista[11]));
    }

    function planoCalibradoValido(item) {
      return item is map
        && item.keys().hasOnly(['referencias', 'verificacion', 'revisada', 'opacidad'])
        && listaParesValida(item.referencias)
        && listaParesValida(item.verificacion)
        && item.revisada is bool
        && item.opacidad is number
        && item.opacidad >= 0
        && item.opacidad <= 1;
    }

    function zonaDispositivoValida(item) {
      return item is map
        && item.keys().hasOnly(['codigo', 'nombre'])
        && item.codigo is number
        && item.codigo >= 0
        && item.codigo <= 30
        && item.codigo == int(item.codigo)
        && item.nombre is string
        && item.nombre.size() > 0
        && item.nombre.size() <= 80;
    }

    function subelementoDispositivoValido(item) {
      return item is map
        && item.keys().hasOnly(['nombre', 'estado'])
        && item.nombre is string
        && item.nombre.size() > 0
        && item.nombre.size() <= 80
        && item.estado is string
        && item.estado.size() > 0
        && item.estado.size() <= 40;
    }

    function incidenciaDispositivoValida(item) {
      return item is map
        && item.keys().hasOnly(['id', 'fecha', 'texto', 'estado'])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 80
        && item.fecha is string
        && item.fecha.size() <= 40
        && item.texto is string
        && item.texto.size() > 0
        && item.texto.size() <= 500
        && item.estado is string
        && item.estado.size() <= 40;
    }

    function puntoDispositivoValido(item) {
      return item is map
        && item.keys().hasOnly(['mapa', 'x', 'y'])
        && item.mapa in ['general', 'berbes_interiores', 'lonjas_interiores']
        && item.x is number
        && item.x >= 0
        && item.x <= 100
        && item.y is number
        && item.y >= 0
        && item.y <= 100;
    }

    function dispositivoValido() {
      return request.resource.data.keys().hasOnly([
          'tipo', 'numero', 'nombre', 'zonas', 'estado', 'subelementos', 'incidencias',
          'oculto', 'ocultoMotivo', 'fueraPlano', 'puntos', 'geoManual', 'ausente', 'actualizadoEn'
        ])
        && request.resource.data.tipo in ['CAMARA', 'BARRERA', 'PORTALON', 'TORNO']
        && request.resource.data.numero is string
        && request.resource.data.numero.size() <= 8
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.zonas is list
        && request.resource.data.zonas.size() > 0
        && request.resource.data.zonas.size() <= 6
        && request.resource.data.zonas[0] is int
        && (request.resource.data.zonas.size() < 2 || request.resource.data.zonas[1] is int)
        && (request.resource.data.zonas.size() < 3 || request.resource.data.zonas[2] is int)
        && (request.resource.data.zonas.size() < 4 || request.resource.data.zonas[3] is int)
        && (request.resource.data.zonas.size() < 5 || request.resource.data.zonas[4] is int)
        && (request.resource.data.zonas.size() < 6 || request.resource.data.zonas[5] is int)
        && request.resource.data.estado is string
        && request.resource.data.estado.size() > 0
        && request.resource.data.estado.size() <= 40
        && request.resource.data.subelementos is list
        && request.resource.data.subelementos.size() <= 8
        && (request.resource.data.subelementos.size() < 1 || subelementoDispositivoValido(request.resource.data.subelementos[0]))
        && (request.resource.data.subelementos.size() < 2 || subelementoDispositivoValido(request.resource.data.subelementos[1]))
        && (request.resource.data.subelementos.size() < 3 || subelementoDispositivoValido(request.resource.data.subelementos[2]))
        && (request.resource.data.subelementos.size() < 4 || subelementoDispositivoValido(request.resource.data.subelementos[3]))
        && (request.resource.data.subelementos.size() < 5 || subelementoDispositivoValido(request.resource.data.subelementos[4]))
        && (request.resource.data.subelementos.size() < 6 || subelementoDispositivoValido(request.resource.data.subelementos[5]))
        && (request.resource.data.subelementos.size() < 7 || subelementoDispositivoValido(request.resource.data.subelementos[6]))
        && (request.resource.data.subelementos.size() < 8 || subelementoDispositivoValido(request.resource.data.subelementos[7]))
        && request.resource.data.incidencias is list
        && request.resource.data.incidencias.size() <= 12
        && (request.resource.data.incidencias.size() < 1 || incidenciaDispositivoValida(request.resource.data.incidencias[0]))
        && (request.resource.data.incidencias.size() < 2 || incidenciaDispositivoValida(request.resource.data.incidencias[1]))
        && (request.resource.data.incidencias.size() < 3 || incidenciaDispositivoValida(request.resource.data.incidencias[2]))
        && (request.resource.data.incidencias.size() < 4 || incidenciaDispositivoValida(request.resource.data.incidencias[3]))
        && (request.resource.data.incidencias.size() < 5 || incidenciaDispositivoValida(request.resource.data.incidencias[4]))
        && (request.resource.data.incidencias.size() < 6 || incidenciaDispositivoValida(request.resource.data.incidencias[5]))
        && (request.resource.data.incidencias.size() < 7 || incidenciaDispositivoValida(request.resource.data.incidencias[6]))
        && (request.resource.data.incidencias.size() < 8 || incidenciaDispositivoValida(request.resource.data.incidencias[7]))
        && (request.resource.data.incidencias.size() < 9 || incidenciaDispositivoValida(request.resource.data.incidencias[8]))
        && (request.resource.data.incidencias.size() < 10 || incidenciaDispositivoValida(request.resource.data.incidencias[9]))
        && (request.resource.data.incidencias.size() < 11 || incidenciaDispositivoValida(request.resource.data.incidencias[10]))
        && (request.resource.data.incidencias.size() < 12 || incidenciaDispositivoValida(request.resource.data.incidencias[11]))
        && request.resource.data.oculto is bool
        && request.resource.data.ocultoMotivo is string
        && request.resource.data.ocultoMotivo.size() <= 200
        && request.resource.data.fueraPlano is bool
        && request.resource.data.puntos is list
        && request.resource.data.puntos.size() <= 3
        && (request.resource.data.puntos.size() < 1 || puntoDispositivoValido(request.resource.data.puntos[0]))
        && (request.resource.data.puntos.size() < 2 || puntoDispositivoValido(request.resource.data.puntos[1]))
        && (request.resource.data.puntos.size() < 3 || puntoDispositivoValido(request.resource.data.puntos[2]))
        && (!request.resource.data.keys().hasAny(['geoManual'])
          || (request.resource.data.geoManual is map
            && request.resource.data.geoManual.keys().hasOnly(['lat', 'lng'])
            && request.resource.data.geoManual.lat is number
            && request.resource.data.geoManual.lng is number))
        && request.resource.data.ausente is bool
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    /** Cámaras, barreras, tornos y portalones. El centro de control solo cambia estado e incidencias. */
    match /dispositivos/{id} {
      allow read: if esUsuarioNodus();
      allow create: if leeTodo() && dispositivoValido();
      allow update: if dispositivoValido() && (
        leeTodo()
        || (esUsuarioNodus()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'incidencias', 'actualizadoEn'])
          && request.resource.data.estado in ['OPERATIVA', 'NO OPERATIVA'])
      );
      allow delete: if leeTodo();
    }

    /** Plano de muelles y coordenadas de atraque. Solo admin o superadmin escriben. */
    match /graficosConfig/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if leeTodo() && (
        (id == 'plano'
          && request.resource.data.keys().hasOnly(['muelles'])
          && request.resource.data.muelles is list
          && request.resource.data.muelles.size() > 0
          && request.resource.data.muelles.size() <= 12)
        || (id == 'posiciones'
          && request.resource.data.keys().hasOnly(['posiciones'])
          && request.resource.data.posiciones is list
          && posicionesListaValida(request.resource.data.posiciones))
        || (id == 'dispositivosCalibracion'
          && request.resource.data.keys().hasOnly(['general', 'berbes_interiores', 'lonjas_interiores', 'zonas'])
          && request.resource.data.general is map
          && request.resource.data.berbes_interiores is map
          && request.resource.data.lonjas_interiores is map
          && request.resource.data.zonas is list
          && request.resource.data.zonas.size() <= 20)
      );
      allow delete: if false;
    }

    function agenteAsignadoValido(item) {
      return item is map
        && item.keys().hasOnly(['agenteId', 'numeroPlaca', 'nombre'])
        && item.agenteId is string
        && item.agenteId.size() <= 64
        && item.numeroPlaca is string
        && item.numeroPlaca.size() <= 16
        && item.nombre is string
        && item.nombre.size() <= 120;
    }

    function puestoParValido(fila) {
      return fila is map
        && fila.keys().hasOnly(['1', '2'])
        && agenteAsignadoValido(fila['1'])
        && agenteAsignadoValido(fila['2']);
    }

    function operadoresValidos(mapa) {
      return mapa is map
        && mapa.keys().hasOnly(['noche-1', 'manana', 'tarde', 'noche-2'])
        && puestoParValido(mapa['noche-1'])
        && puestoParValido(mapa.manana)
        && puestoParValido(mapa.tarde)
        && puestoParValido(mapa['noche-2']);
    }

    function campoTexto(mapa, clave) {
      return !(clave in mapa)
        || (mapa[clave] is string && mapa[clave].size() > 0 && mapa[clave].size() <= 400);
    }

    function camposRegistroValidos(mapa) {
      return mapa is map
        && mapa.size() > 0
        && mapa.size() <= 20
        && mapa.keys().hasOnly([
          'tipo', 'hora', 'buque', 'muelle', 'atraque', 'numeroEscala', 'grua', 'estibadores', 'horaFin',
          'portalon', 'accion', 'motivo', 'informacion', 'descripcion', 'referencia',
          'numeroParte', 'estado', 'estadoCierra', 'camara', 'acta', 'extraccion', 'solicitante', 'protocolo', 'llave', 'llaveId',
          'equipos', 'equiposTexto',
          'nombre', 'empresa', 'gestion',
          'piezas', 'desde', 'hasta', 'incidencias',
          'receptor', 'ubicacion', 'recorrido', 'equipo', 'zona', 'autorizacion', 'observaciones'
        ])
        && campoTexto(mapa, 'tipo')
        && campoTexto(mapa, 'hora')
        && campoTexto(mapa, 'buque')
        && campoTexto(mapa, 'muelle')
        && campoTexto(mapa, 'atraque')
        && campoTexto(mapa, 'numeroEscala')
        && campoTexto(mapa, 'grua')
        && campoTexto(mapa, 'estibadores')
        && campoTexto(mapa, 'horaFin')
        && campoTexto(mapa, 'portalon')
        && campoTexto(mapa, 'accion')
        && campoTexto(mapa, 'motivo')
        && campoTexto(mapa, 'informacion')
        && campoTexto(mapa, 'descripcion')
        && campoTexto(mapa, 'referencia')
        && campoTexto(mapa, 'numeroParte')
        && campoTexto(mapa, 'estado')
        && campoTexto(mapa, 'estadoCierra')
        && campoTexto(mapa, 'camara')
        && campoTexto(mapa, 'acta')
        && campoTexto(mapa, 'extraccion')
        && campoTexto(mapa, 'nombre')
        && campoTexto(mapa, 'empresa')
        && campoTexto(mapa, 'gestion')
        && campoTexto(mapa, 'piezas')
        && campoTexto(mapa, 'desde')
        && campoTexto(mapa, 'hasta')
        && campoTexto(mapa, 'incidencias')
        && campoTexto(mapa, 'solicitante')
        && campoTexto(mapa, 'protocolo')
        && campoTexto(mapa, 'llave')
        && campoTexto(mapa, 'llaveId')
        && campoTexto(mapa, 'receptor')
        && campoTexto(mapa, 'ubicacion')
        && campoTexto(mapa, 'recorrido')
        && campoTexto(mapa, 'equipo')
        && campoTexto(mapa, 'zona')
        && campoTexto(mapa, 'autorizacion')
        && campoTexto(mapa, 'observaciones')
        && campoTexto(mapa, 'equipos')
        && campoTexto(mapa, 'equiposTexto');
    }

    function diaRegistroValido() {
      return request.resource.data.keys().hasOnly(['fecha', 'operadores', 'actualizadoEn', 'actualizadoPorUid', 'actualizadoPorNombre'])
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && operadoresValidos(request.resource.data.operadores)
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoPorUid == request.auth.uid
        && request.resource.data.actualizadoPorNombre is string
        && request.resource.data.actualizadoPorNombre.size() > 0
        && request.resource.data.actualizadoPorNombre.size() <= 120;
    }

    function isoDia(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    /**
     * Ayer, hoy o mañana en UTC. Cubre la fecha local de España y el turno
     * de noche; los días anteriores ya no los reescribe un agente.
     */
    function fechaDeServicio(fecha) {
      return fecha == isoDia(request.time)
        || fecha == isoDia(request.time - duration.value(1, 'd'))
        || fecha == isoDia(request.time + duration.value(1, 'd'));
    }

    function filaRegistroValida() {
      return request.resource.data.keys().hasOnly(['fecha', 'bloque', 'campos', 'abierto', 'fechaCierre', 'horaCierre', 'autorUid', 'autorNombre', 'autorPlaca', 'creadoEn'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.fecha is string
        && request.resource.data.fecha.size() == 10
        && request.resource.data.bloque is string
        && request.resource.data.bloque.size() > 0
        && request.resource.data.bloque.size() <= 24
        && camposRegistroValidos(request.resource.data.campos)
        && request.resource.data.abierto is bool
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.autorPlaca is string
        && request.resource.data.autorPlaca.size() <= 16
        && firmaPropia(request.resource.data.autorNombre, request.resource.data.autorPlaca)
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && (
          request.resource.data.abierto == true
          || !request.resource.data.keys().hasAny(['fechaCierre'])
          || (
            request.resource.data.fechaCierre == request.resource.data.fecha
            && request.resource.data.horaCierre is string
            && request.resource.data.horaCierre.size() == 5
          )
        );
    }

    /**
     * Las claves que no cambian ya se validaron al crear la fila; revisar las
     * 40 en cada actualización agota el límite de 1000 expresiones.
     */
    function camposCambianSolo(claves) {
      let nuevos = request.resource.data.campos;
      return nuevos is map
        && nuevos.size() > 0
        && nuevos.size() <= 20
        && nuevos.diff(resource.data.campos).affectedKeys().hasOnly(claves)
        && campoTexto(nuevos, 'horaFin')
        && campoTexto(nuevos, 'estado')
        && campoTexto(nuevos, 'estadoCierra')
        && campoTexto(nuevos, 'numeroParte')
        && campoTexto(nuevos, 'incidencias');
    }

    function cierreFilaValido() {
      return resource.data.abierto == true
        && request.resource.data.abierto == false
        && (resource.data.autorUid == request.auth.uid || leeTodo() || resource.data.bloque in ['llaves', 'protocolos', 'transportes', 'varios'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abierto', 'fechaCierre', 'horaCierre', 'campos', 'cerradoEn', 'cerradoPorUid', 'cerradoPorNombre'])
        && request.resource.data.fechaCierre is string
        && request.resource.data.fechaCierre.size() == 10
        && request.resource.data.fechaCierre >= resource.data.fecha
        && request.resource.data.horaCierre is string
        && request.resource.data.horaCierre.size() == 5
        && camposCambianSolo(['horaFin', 'estado', 'estadoCierra', 'numeroParte', 'incidencias'])
        && request.resource.data.cerradoEn is string
        && request.resource.data.cerradoEn.size() >= 20
        && request.resource.data.cerradoEn.size() <= 40
        && request.resource.data.cerradoPorUid == request.auth.uid
        && request.resource.data.cerradoPorNombre is string
        && request.resource.data.cerradoPorNombre.size() > 0
        && request.resource.data.cerradoPorNombre.size() <= 120
        && nombrePropio(request.resource.data.cerradoPorNombre);
    }

    /**
     * Actualiza un registro que sigue abierto, sin cerrarlo: número de parte
     * del protocolo, incidencias del transporte o estado de varios.
     */
    function anotacionFilaValida() {
      return resource.data.abierto == true
        && request.resource.data.abierto == true
        && resource.data.bloque in ['protocolos', 'transportes', 'varios']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campos'])
        && camposCambianSolo(['numeroParte', 'incidencias', 'estado', 'estadoCierra']);
    }

    /** Corrige las incidencias de un transporte ya cerrado. El resto de la fila no cambia. */
    function correccionFilaValida() {
      return resource.data.abierto == false
        && request.resource.data.abierto == false
        && resource.data.bloque == 'transportes'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['campos'])
        && camposCambianSolo(['incidencias']);
    }

    function catalogoOperativoValido() {
      return request.resource.data.keys().hasOnly(['tipo', 'nombre', 'sigue', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.tipo in ['empresa', 'desde', 'hasta', 'estado']
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.sigue is bool
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    /** Empresas, orígenes, destinos y estados que usa el registro diario. */
    match /catalogoOperativo/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if leeTodo() && catalogoOperativoValido();
      allow delete: if leeTodo();
    }

    match /registroControlDias/{fecha} {
      allow read: if esUsuarioNodus();
      allow create, update: if diaRegistroValido()
        && request.resource.data.fecha == fecha
        && (
          leeTodo()
          || (
            esConsulta()
            && fechaDeServicio(fecha)
            && nombreDeConsulta(request.resource.data.actualizadoPorNombre)
          )
        );
      allow delete: if leeTodo();
    }

    match /registroControlFilas/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus() && filaRegistroValida();
      allow update: if esUsuarioNodus() && (cierreFilaValido() || anotacionFilaValida() || correccionFilaValida());
      allow delete: if esUsuarioNodus() && (leeTodo() || resource.data.autorUid == request.auth.uid);
    }

    function ajustesAccesosValidos() {
      return request.resource.data.keys().hasOnly(['puestosToma', 'puestoControlId', 'actualizadoEn'])
        && request.resource.data.puestosToma is list
        && request.resource.data.puestosToma.size() <= 40
        && request.resource.data.puestoControlId is string
        && request.resource.data.puestoControlId.size() <= 64
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    function pasoAccesoValido() {
      return request.resource.data.keys().hasOnly([
          'fecha', 'turno', 'puestoId', 'puestoNombre', 'matricula', 'tipoVehiculo',
          'empresaPertenece', 'empresaDestino', 'autorUid', 'autorNombre', 'autorPlaca', 'creadoEn',
          'creadoServidor'
        ])
        && (
          !request.resource.data.keys().hasAny(['creadoServidor'])
          || request.resource.data.creadoServidor == request.time
        )
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.turno in ['Mañana', 'Tarde', 'Noche']
        && request.resource.data.puestoId is string
        && request.resource.data.puestoId.size() > 0
        && request.resource.data.puestoId.size() <= 64
        && request.resource.data.puestoNombre is string
        && request.resource.data.puestoNombre.size() > 0
        && request.resource.data.puestoNombre.size() <= 80
        && request.resource.data.matricula is string
        && request.resource.data.matricula.matches('^[A-Z0-9]{4,12}$')
        && request.resource.data.tipoVehiculo in ['Turismo', 'Furgoneta', 'Camión', 'Cabeza tractora', 'Autobús', 'Motocicleta', 'Maquinaria', 'Otro']
        && request.resource.data.empresaPertenece is string
        && request.resource.data.empresaPertenece.size() > 0
        && request.resource.data.empresaPertenece.size() <= 80
        && request.resource.data.empresaDestino is string
        && request.resource.data.empresaDestino.size() > 0
        && request.resource.data.empresaDestino.size() <= 80
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.autorPlaca is string
        && request.resource.data.autorPlaca.size() <= 16
        && firmaPropia(request.resource.data.autorNombre, request.resource.data.autorPlaca)
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40;
    }

    /** El autor puede retirar un paso mal anotado durante 15 minutos (hora del servidor). */
    function pasoRetirablePorAutor() {
      return resource.data.autorUid == request.auth.uid
        && resource.data.get('creadoServidor', null) is timestamp
        && request.time < resource.data.creadoServidor + duration.value(15, 'm');
    }

    /** Puestos que toman datos y el puesto de Control de Accesos. */
    match /accesosAjustes/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if leeTodo() && ajustesAccesosValidos();
      allow delete: if leeTodo();
    }

    /** Pasos de matrícula anotados en los puestos de acceso. */
    match /accesosPasos/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus() && pasoAccesoValido();
      allow delete: if esUsuarioNodus() && (leeTodo() || pasoRetirablePorAutor());
    }

    function vehiculoFlotaValido() {
      return request.resource.data.keys().hasOnly(['code', 'label', 'plate', 'active'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 16
        && request.resource.data.plate is string
        && request.resource.data.plate.size() > 0
        && request.resource.data.plate.size() <= 24
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 64
        && request.resource.data.active is bool;
    }

    /** Alta inicial V01–V07. Cualquier usuario de NODUS puede crearla si aún no existe. */
    function esSemillaFlota(codigo) {
      return request.resource.data.active == true
        && (
          (codigo == 'V01' && request.resource.data.code == 'V01' && request.resource.data.plate == '0964 MVM' && request.resource.data.label == 'V01 - 0964 MVM')
          || (codigo == 'V02' && request.resource.data.code == 'V02' && request.resource.data.plate == '0965 MVM' && request.resource.data.label == 'V02 - 0965 MVM')
          || (codigo == 'V03' && request.resource.data.code == 'V03' && request.resource.data.plate == '0957 MVM' && request.resource.data.label == 'V03 - 0957 MVM')
          || (codigo == 'V04' && request.resource.data.code == 'V04' && request.resource.data.plate == '0958 MVM' && request.resource.data.label == 'V04 - 0958 MVM')
          || (codigo == 'V05' && request.resource.data.code == 'V05' && request.resource.data.plate == '0954 MVM' && request.resource.data.label == 'V05 - 0954 MVM')
          || (codigo == 'V06' && request.resource.data.code == 'V06' && request.resource.data.plate == '1628 MTB' && request.resource.data.label == 'V06 - 1628 MTB')
          || (codigo == 'V07' && request.resource.data.code == 'V07' && request.resource.data.plate == '9132 MTM' && request.resource.data.label == 'V07 - 9132 MTM')
        );
    }

    function numeroFlota(valor) {
      return valor == null || (valor is number && valor >= 0 && valor <= 10000000);
    }

    function marcaUsoFlota(valor) {
      return valor is string && valor.size() >= 20 && valor.size() <= 40;
    }

    function usoVehiculoValido() {
      return request.resource.data.keys().hasOnly([
          'kind', 'status', 'agentNumber', 'zone', 'shift', 'vehicleId', 'vehicleLabel', 'plate',
          'startTime', 'startKm', 'hasDefects', 'defects', 'equipmentStatus', 'equipmentIncident',
          'endTime', 'endKm', 'refueled', 'liters', 'shiftIncidents', 'cleanliness', 'openedAt', 'closedAt'
        ])
        && request.resource.data.kind in ['turno', 'otros']
        && request.resource.data.status in ['abierto', 'cerrado']
        && request.resource.data.agentNumber is string
        && request.resource.data.agentNumber.size() > 0
        && request.resource.data.agentNumber.size() <= 32
        && request.resource.data.zone in ['Plaza Estrella', 'Berbés', 'Bouzas']
        && request.resource.data.shift in ['Mañana', 'Tarde', 'Noche']
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleId.size() > 0
        && request.resource.data.vehicleId.size() <= 64
        && request.resource.data.vehicleLabel is string
        && request.resource.data.vehicleLabel.size() > 0
        && request.resource.data.vehicleLabel.size() <= 80
        && request.resource.data.plate is string
        && request.resource.data.plate.size() > 0
        && request.resource.data.plate.size() <= 24
        && request.resource.data.startTime is string
        && request.resource.data.startTime.size() > 0
        && request.resource.data.startTime.size() <= 8
        && numeroFlota(request.resource.data.startKm)
        && (request.resource.data.hasDefects == null || request.resource.data.hasDefects is bool)
        && request.resource.data.defects is string
        && request.resource.data.defects.size() <= 400
        && (request.resource.data.equipmentStatus == null || request.resource.data.equipmentStatus in ['Todo OK', 'Incidencia'])
        && request.resource.data.equipmentIncident is string
        && request.resource.data.equipmentIncident.size() <= 400
        && request.resource.data.endTime is string
        && request.resource.data.endTime.size() <= 8
        && numeroFlota(request.resource.data.endKm)
        && (request.resource.data.refueled == null || request.resource.data.refueled is bool)
        && numeroFlota(request.resource.data.liters)
        && request.resource.data.shiftIncidents is string
        && request.resource.data.shiftIncidents.size() <= 400
        && (request.resource.data.cleanliness == null || request.resource.data.cleanliness in [1, 2, 3, 4, 5])
        && marcaUsoFlota(request.resource.data.openedAt)
        && (
          request.resource.data.status == 'abierto'
            ? (request.resource.data.kind == 'turno' && request.resource.data.closedAt == null)
            : marcaUsoFlota(request.resource.data.closedAt)
        );
    }

    /** Un agente abre su propio turno, sin datos de cierre, o anota otro uso ya cerrado con su placa. */
    function usoNuevoDelAgente() {
      return placaDeConsulta(request.resource.data.agentNumber)
        && (
          (
            request.resource.data.kind == 'turno'
            && request.resource.data.status == 'abierto'
            && request.resource.data.endTime == ''
            && request.resource.data.endKm == null
            && request.resource.data.refueled == null
            && request.resource.data.liters == null
            && request.resource.data.cleanliness == null
          )
          || (request.resource.data.kind == 'otros' && request.resource.data.status == 'cerrado')
        );
    }

    /** Cierre de un turno abierto: solo los datos de cierre. La apertura y los km iniciales no cambian. */
    function cierreUsoValido() {
      return resource.data.kind == 'turno'
        && resource.data.status == 'abierto'
        && request.resource.data.status == 'cerrado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'endTime', 'endKm', 'refueled', 'liters', 'shiftIncidents', 'cleanliness', 'closedAt'
        ])
        && request.resource.data.endTime.size() > 0
        && request.resource.data.endKm is number
        && (resource.data.startKm == null || request.resource.data.endKm >= resource.data.startKm)
        && request.resource.data.refueled is bool
        && request.resource.data.cleanliness != null;
    }

    /** Parque compartido. La ficha la administra jefatura; la semilla inicial la puede crear cualquier usuario. */
    match /vehiculosFlota/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus() && vehiculoFlotaValido() && id != 'sustitucion' && (leeTodo() || esSemillaFlota(id));
      allow update: if leeTodo() && vehiculoFlotaValido();
      allow delete: if leeTodo();
    }

    function esOficialProteccion() {
      return leeTodo()
        || (esConsulta() && perfilConsulta().get('oficialProteccion', false) == true);
    }

    function manifiestoCruceroOk(valor) {
      return valor == null
        || (
          valor is map
          && valor.keys().hasOnly(['archivo', 'columnas', 'filas'])
          && valor.archivo is string
          && valor.archivo.size() <= 180
          && valor.columnas is list
          && valor.columnas.size() <= 16
          && valor.filas is list
          && valor.filas.size() <= 400
        );
    }

    function servicioCruceroOk(valor) {
      return valor is map
        && valor.keys().hasOnly(['horario', 'terminal', 'jefeManana', 'jefeTarde', 'puestos', 'notas'])
        && valor.horario is string
        && valor.horario.size() <= 40
        && valor.terminal is string
        && valor.terminal.size() <= 120
        && valor.notas is string
        && valor.notas.size() <= 4000
        && valor.puestos is list
        && valor.puestos.size() <= 16
        && (valor.jefeManana == null || valor.jefeManana is map)
        && (valor.jefeTarde == null || valor.jefeTarde is map);
    }

    function cruceroValido() {
      return request.resource.size() < 900000
        && request.resource.data.keys().hasOnly([
          'fecha', 'buque', 'eta', 'etd', 'procedencia', 'destino', 'eslora', 'terminal', 'consignatario',
          'oficialNombre', 'oficialExtension',
          'pasajeros', 'embarquesPasajeros', 'desembarquesPasajeros',
          'tripulantes', 'embarquesTripulantes', 'desembarquesTripulantes',
          'autobusesGuias', 'excursionesOficiales', 'otrasExcursiones', 'repartoPlanos',
          'personasPlanos', 'listaConsignatario', 'autobuses',
          'coordinadorNombre', 'coordinadorDni', 'coordinadorTelefono', 'coordinadorMatricula', 'coordinadorEmpresa',
          'taxiMatricula', 'taxiConductor', 'taxiDni', 'taxiPasajeros', 'taxiHora',
          'taxisOficiales', 'taxisConsignatario',
          'serviciosBuque', 'accesosProteccion', 'visitas',
          'pasajerosManifiesto', 'tripulacionManifiesto', 'movimientosManifiesto',
          'autorUid', 'autorNombre', 'creadoEn', 'actualizadoEn'
        ])
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.buque is string
        && request.resource.data.buque.size() > 0
        && request.resource.data.buque.size() <= 120
        && request.resource.data.eta is string
        && request.resource.data.eta.size() <= 8
        && request.resource.data.etd is string
        && request.resource.data.etd.size() <= 8
        && request.resource.data.repartoPlanos in ['', 'SI', 'NO']
        && request.resource.data.personasPlanos is list
        && request.resource.data.personasPlanos.size() <= 30
        && request.resource.data.listaConsignatario is list
        && request.resource.data.listaConsignatario.size() <= 80
        && request.resource.data.autobuses is list
        && request.resource.data.autobuses.size() <= 40
        && request.resource.data.taxisOficiales is list
        && request.resource.data.taxisOficiales.size() <= 40
        && request.resource.data.taxisConsignatario is list
        && request.resource.data.taxisConsignatario.size() <= 40
        && request.resource.data.serviciosBuque is list
        && request.resource.data.serviciosBuque.size() <= 80
        && request.resource.data.accesosProteccion is list
        && request.resource.data.accesosProteccion.size() <= 80
        && request.resource.data.visitas is list
        && request.resource.data.visitas.size() <= 80
        && manifiestoCruceroOk(request.resource.data.pasajerosManifiesto)
        && manifiestoCruceroOk(request.resource.data.tripulacionManifiesto)
        && manifiestoCruceroOk(request.resource.data.movimientosManifiesto)
        && request.resource.data.autorUid is string
        && request.resource.data.autorUid.size() > 0
        && request.resource.data.autorUid.size() <= 128
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.creadoEn is string
        && request.resource.data.creadoEn.size() >= 20
        && request.resource.data.creadoEn.size() <= 40
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    function autorCruceroNuevo() {
      return request.resource.data.autorUid == request.auth.uid
        && nombrePropio(request.resource.data.autorNombre);
    }

    function autorCruceroConservado() {
      return request.resource.data.autorUid == resource.data.autorUid
        && request.resource.data.autorNombre == resource.data.autorNombre
        && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    function anotacionCruceroOk(id) {
      return request.resource.size() < 200000
        && request.resource.data.keys().hasOnly([
          'cruceroId', 'fecha', 'horas', 'otrosAccesos', 'autorUid', 'autorNombre', 'actualizadoEn'
        ])
        && request.resource.data.cruceroId == id
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.horas is map
        && request.resource.data.horas.size() <= 40
        && request.resource.data.otrosAccesos is list
        && request.resource.data.otrosAccesos.size() <= 80
        && request.resource.data.autorUid == request.auth.uid
        && nombrePropio(request.resource.data.autorNombre)
        && request.resource.data.autorNombre.size() > 0
        && request.resource.data.autorNombre.size() <= 120
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
    }

    /** Ficha de la escala. La escribe el Oficial de Protección. El jefe solo cubre el servicio. */
    match /cruceros/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esOficialProteccion() && cruceroValido() && autorCruceroNuevo();
      allow update: if esOficialProteccion() && cruceroValido() && autorCruceroConservado();
      allow delete: if esOficialProteccion();
    }

    /** Dispositivo de Policía Portuaria. Lo cubre el Oficial o el jefe de servicio. */
    match /crucerosServicio/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if (esOficialProteccion() || esJefaturaConsulta())
        && request.resource.size() < 100000
        && request.resource.data.keys().hasOnly(['cruceroId', 'fecha', 'servicio', 'actualizadoEn'])
        && request.resource.data.cruceroId == id
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && servicioCruceroOk(request.resource.data.servicio)
        && request.resource.data.actualizadoEn is string
        && request.resource.data.actualizadoEn.size() >= 20
        && request.resource.data.actualizadoEn.size() <= 40;
      allow delete: if esOficialProteccion();
    }

    /** Horas reales de autobús y otros accesos que anota la policía. */
    match /crucerosAnotaciones/{id} {
      allow read: if esUsuarioNodus();
      allow create, update: if esUsuarioNodus() && anotacionCruceroOk(id);
      allow delete: if esUsuarioNodus();
    }

    /** Aperturas, cierres y otros usos del parque. */
    match /vehiculosUsos/{id} {
      allow read: if esUsuarioNodus();
      allow create: if esUsuarioNodus()
        && usoVehiculoValido()
        && id.size() > 0
        && id.size() <= 80
        && (leeTodo() || usoNuevoDelAgente());
      allow update: if esUsuarioNodus()
        && usoVehiculoValido()
        && (leeTodo() || cierreUsoValido());
      allow delete: if leeTodo();
    }
  }
}
